# MandateKey dashboard environment — copy to `.env.local` and fill in.
# `.env.local` is gitignored; NEVER commit secrets.

# Path to the ledgeroot SQLite database (server-side only).
# Relative to the mandatekey directory; ledgeroot and mandatekey are siblings.
LEDGEROOT_DB=../ledgeroot/ledgeroot.sqlite

# Anchor contract address (client-side). Keep the NEXT_PUBLIC_ prefix so the
# browser can read it for the on-chain anchor status card.
NEXT_PUBLIC_ANCHOR_ADDRESS=0x...
