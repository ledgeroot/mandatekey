# MandateKey dashboard environment — copy to `.env.local` and fill in.
# `.env.local` is gitignored; NEVER commit secrets.

# Path to the ledgeroot SQLite database (server-side only).
# Relative to the mandatekey directory; ledgeroot and mandatekey are siblings.
LEDGEROOT_DB=../ledgeroot/ledgeroot.sqlite

# Receipt signing key (server-side only). Ledgeroot signs every receipt it
# writes with this key and MandateKey reads it to check attribution, so both
# sides must agree on the same value. 32-byte hex seed: 0x + 64 hex chars.
# Leave blank to skip signing — receipts then verify as "incomplete", not
# "verified".
LEDGEROOT_SIGNING_KEY=

# Self-contained demo alternative to the key above: derives a deterministic
# throwaway key so the seed and the dashboard agree with no secret to manage.
# Never use for real payments. Ignored when LEDGEROOT_SIGNING_KEY is set.
# LEDGEROOT_DRY_RUN=true

# Anchor contract address (client-side), on Monad mainnet (chainId 143). Keep the
# NEXT_PUBLIC_ prefix so the browser can read it for the on-chain anchor status
# card. It must be the contract the engine anchored to — the two chains have to
# agree or the card reports a root mismatch.
NEXT_PUBLIC_ANCHOR_ADDRESS=0x...
