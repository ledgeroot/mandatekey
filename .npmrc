# This machine may have NODE_ENV=production set globally, which makes `npm install`
# silently skip devDependencies. That breaks typecheck, `next build` and `next dev`
# in confusing ways (TypeScript types missing, Turbopack unable to transform), so
# dev dependencies are always installed here. This repository is a private app,
# not a published package, so there is no production install to protect.
include=dev
